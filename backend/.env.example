# PostgreSQL + pgvector; use the same database where esquema_bd.sql was imported.
DATABASE_URL=postgresql+psycopg://reposalud:reposalud@localhost:5432/reposalud
UPLOAD_DIR=./uploads

# Secret used to sign/verify JWTs issued by POST /auth/sesiones. Use a long random
# value in any shared/deployed environment; never commit the real value.
JWT_SECRET=change-me-to-a-long-random-value
# Access token lifetime in seconds. Matches the contract's documented session
# lifetime (RNF-06: 30 days without activity).
JWT_EXPIRATION=2592000
