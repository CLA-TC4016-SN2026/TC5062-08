# PostgreSQL + pgvector; use the same database where esquema_bd.sql was imported.
DATABASE_URL=postgresql+psycopg://reposalud:reposalud@localhost:5432/reposalud
UPLOAD_DIR=./uploads

# Optional development-only actor identity for routes that need an account context.
# This is not authentication. Requests may also send X-Actor-Account-Id.
DEV_ACTOR_ACCOUNT_ID=
