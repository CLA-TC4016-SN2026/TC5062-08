{
  "info": {
    "name": "RepoSalud - Flujo de autenticación JWT (S05_S06_A2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8001/api/v1" },
    { "key": "correo", "value": "paciente.video@example.com" },
    { "key": "medicoCorreo", "value": "medico.video@example.com" },
    { "key": "cuentaId", "value": "" },
    { "key": "desafioId", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "medicoCuentaId", "value": "" },
    { "key": "medicoDesafioId", "value": "" },
    { "key": "medicoAccessToken", "value": "" },
    { "key": "repositorioId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Registrar cuenta (paciente)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Paciente Video\",\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"Secreta123!\",\n  \"tipoCuenta\": \"paciente\",\n  \"avisoPrivacidadAceptado\": true,\n  \"consentimientoDatosSalud\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/cuentas", "host": ["{{baseUrl}}"], "path": ["cuentas"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('cuentaId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Verificar correo (dev: token = id de cuenta)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{cuentaId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/cuentas/verificacion-correo", "host": ["{{baseUrl}}"], "path": ["cuentas", "verificacion-correo"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }
      ]
    },
    {
      "name": "3. Solicitar código OTP (login paso 1)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"Secreta123!\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/desafios", "host": ["{{baseUrl}}"], "path": ["auth", "desafios"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('desafioId', body.desafioId);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login (OTP dev = 000000) -> JWT",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"desafioId\": \"{{desafioId}}\",\n  \"codigo\": \"000000\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/sesiones", "host": ["{{baseUrl}}"], "path": ["auth", "sesiones"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.test('accessToken is a JWT', () => pm.expect(body.accessToken.split('.').length).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Crear repositorio (ruta protegida, CON token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titularEsOperador\": true,\n  \"titularNombreCompleto\": \"Paciente Video\",\n  \"tamanoTexto\": \"normal\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/repositorios", "host": ["{{baseUrl}}"], "path": ["repositorios"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('repositorioId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Obtener mi repositorio (identidad resuelta por el JWT)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/repositorios/mio", "host": ["{{baseUrl}}"], "path": ["repositorios", "mio"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }
      ]
    },
    {
      "name": "7. Obtener mi repositorio SIN token -> 401",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/repositorios/mio", "host": ["{{baseUrl}}"], "path": ["repositorios", "mio"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }
      ]
    },
    {
      "name": "8a. Registrar cuenta médico (para probar rol incorrecto)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Medico Video\",\n  \"correo\": \"{{medicoCorreo}}\",\n  \"contrasena\": \"Secreta123!\",\n  \"tipoCuenta\": \"medico\",\n  \"avisoPrivacidadAceptado\": true,\n  \"consentimientoDatosSalud\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/cuentas", "host": ["{{baseUrl}}"], "path": ["cuentas"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('medicoCuentaId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8b. Verificar correo médico",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{medicoCuentaId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/cuentas/verificacion-correo", "host": ["{{baseUrl}}"], "path": ["cuentas", "verificacion-correo"] }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "8c. Solicitar OTP médico",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{medicoCorreo}}\",\n  \"contrasena\": \"Secreta123!\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/desafios", "host": ["{{baseUrl}}"], "path": ["auth", "desafios"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('medicoDesafioId', pm.response.json().desafioId);"
            ]
          }
        }
      ]
    },
    {
      "name": "8d. Login médico -> JWT",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"desafioId\": \"{{medicoDesafioId}}\",\n  \"codigo\": \"000000\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/sesiones", "host": ["{{baseUrl}}"], "path": ["auth", "sesiones"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('medicoAccessToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Crear repositorio con token de MÉDICO -> 403 (rol incorrecto)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{medicoAccessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titularEsOperador\": true,\n  \"titularNombreCompleto\": \"Medico Video\",\n  \"tamanoTexto\": \"normal\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/repositorios", "host": ["{{baseUrl}}"], "path": ["repositorios"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }
      ]
    }
  ]
}
